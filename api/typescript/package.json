{
  "name": "@cauteum/control-client",
  "version": "0.0.0-dev",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "generate": "cd ../.. && buf generate --template api/typescript/buf.gen.yaml",
    "build": "tsc -p tsconfig.json",
    "check": "npm run generate && npm run build"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.16.0",
    "@connectrpc/connect": "2.2.0",
    "@connectrpc/connect-web": "2.2.0"
  },
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "2.16.0",
    "typescript": "7.0.2"
  }
}
