# Copy to .env next to docker-compose.yml (compose auto-loads it).
# Pinning WHALESHELL_SECRETS_KEK lets provider secrets survive volume recreate.

# WHALESHELL_SECRETS_KEK=base64-or-passphrase-here

# Optional OIDC (use with --profile oidc + docker-compose.oidc.yml)
# WHALESHELL_OIDC_ISSUER=http://127.0.0.1:5556/dex
# WHALESHELL_OIDC_CLIENT_ID=whaleshell-cli
# WHALESHELL_OIDC_AUDIENCE=
# WHALESHELL_OIDC_ALLOW_INSECURE_HTTP=true
