# Copy to .env next to docker-compose.yml (compose auto-loads it).
# Pinning CAUTEUM_SECRETS_KEK lets provider secrets survive volume recreate.

# CAUTEUM_SECRETS_KEK=base64-or-passphrase-here

# Optional OIDC (use with --profile oidc + docker-compose.oidc.yml)
# CAUTEUM_OIDC_ISSUER=http://127.0.0.1:5556/dex
# CAUTEUM_OIDC_CLIENT_ID=cauteum-cli
# CAUTEUM_OIDC_AUDIENCE=
# CAUTEUM_OIDC_ALLOW_INSECURE_HTTP=true
